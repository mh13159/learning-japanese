# Local environment configuration.
# Copy this file to `.env.local` (gitignored) and adjust as needed.
# This app is fully FOSS — no commercial API keys are required at runtime.

# -----------------------------------------------------------------------------
# LibreTranslate (optional, OPEN-VOCABULARY EN ⇄ JA)
# -----------------------------------------------------------------------------
# When unset, the API falls back to a bundled 152-entry phrase dictionary
# (see lib/seed-translations.ts). For arbitrary text, point this at a
# self-hosted LibreTranslate instance.
#
# Quick start with Docker (in WSL or any Linux/macOS):
#   docker run -d --name libretranslate -p 5000:5000 \
#     libretranslate/libretranslate --load-only en,ja
#
# Quick start with Python (works on Windows / Linux / macOS):
#   pip install libretranslate
#   libretranslate --host 127.0.0.1 --port 5000 --load-only en,ja
#
# Public community mirrors are mostly defunct or paywalled as of 2026-05.
# Self-hosting is the recommended path.
LIBRETRANSLATE_URL=http://localhost:5000

# Optional API key, only if your LibreTranslate instance requires one.
# LIBRETRANSLATE_API_KEY=
